<Window x:Class="SwitchKeypad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SwitchKeypad.UI.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Switch Keypad" Width="1450" Height="940" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#071421" Foreground="White"
        Icon="Assets/Brand/SwitchKeypad.ico" Loaded="Window_Loaded" StateChanged="Window_StateChanged" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#091A28"/><Setter Property="BorderBrush" Value="#18364C"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="TopIconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="58"/><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="23"/><Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="56"/><Setter Property="MinWidth" Value="155"/><Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="ActionCard" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="58"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="{x:Type ui:KeyTileControl}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:KeyTileControl}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#243F55" BorderThickness="1" CornerRadius="12" Background="#071421">
        <Viewbox Stretch="Uniform"><Grid Width="1534" Height="970">
            <Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>

            <!-- Header -->
            <Grid x:Name="HeaderRoot" Grid.Row="0" Margin="28,18,26,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/><ColumnDefinition Width="310"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/Brand/switch-keypad-symbol.png" Width="82" Height="82" Stretch="Uniform" Margin="0,0,18,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Switch Keypad" FontSize="31" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="2,6,0,0"><Ellipse x:Name="HeaderStatusDot" Width="14" Height="14" Fill="#F8B33C"/><TextBlock x:Name="HeaderStatusText" Text="Aguardando dispositivo" Foreground="#EFC26C" FontSize="14" Margin="9,-1,0,0"/></StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource FlatButton}" Height="72" HorizontalContentAlignment="Stretch" Click="DeviceButton_Click">
                    <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                        <TextBlock Text="⌨" FontSize="36" Foreground="#CFE1FA" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock TextTrimming="CharacterEllipsis" x:Name="HeaderDeviceName" Text="Numpad USB Dedicado" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="HeaderDeviceIds" Text="VID: ----    PID: ----" Foreground="#9DB7D2" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="⌄" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#BBD0E7"/>
                    </Grid>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Height="72" Margin="12,0,0,0" Click="ProfileMenu_Click">
                    <StackPanel HorizontalAlignment="Stretch"><TextBlock Text="Perfil Atual" Foreground="#94ADC8" FontSize="12" HorizontalAlignment="Left"/><Grid Margin="0,5,0,0"><Ellipse Width="13" Height="13" Fill="#0A86FF" HorizontalAlignment="Left"/><TextBlock x:Name="HeaderProfileName" Text="Padrão" FontSize="16" Margin="24,0,30,0"/><TextBlock Text="⌄" HorizontalAlignment="Right" FontSize="20"/></Grid></StackPanel>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0"><Button Style="{StaticResource TopIconButton}" Content="＋" Click="NewProfile_Click"/><TextBlock Text="Novo" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><Button Style="{StaticResource TopIconButton}" Content="▣" Click="DuplicateProfile_Click"/><TextBlock Text="Duplicar" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><Button Style="{StaticResource TopIconButton}" Content="⇩" Click="ImportProfile_Click"/><TextBlock Text="Importar" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel><Button Style="{StaticResource TopIconButton}" Content="⇧" Click="ExportProfile_Click"/><TextBlock Text="Exportar" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RunStateButton" Style="{StaticResource FlatButton}" Background="#3A2D14" BorderBrush="#745920" Padding="14,8" Click="ToggleEnabled_Click" ToolTip="Ativar ou desativar a captura do dispositivo"><StackPanel Orientation="Horizontal"><TextBlock x:Name="RunStateIcon" Text="●" Foreground="#F8B33C" Margin="0,0,8,0"/><TextBlock x:Name="RunStateText" Text="Aguardando" Foreground="#EFC26C" FontWeight="SemiBold"/></StackPanel></Button>
                    <Button Style="{StaticResource FlatButton}" Background="Transparent" BorderThickness="0" Content="⚙  Configurações" Margin="0,5,0,0" Click="Settings_Click"/>
                </StackPanel>

                <!-- window controls -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="20" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-18,0">
                    <Button Width="54" Height="32" Content="—" Background="Transparent" BorderThickness="0" Foreground="#BFD4EA" Click="Minimize_Click"/>
                    <Button Width="54" Height="32" Content="□" Background="Transparent" BorderThickness="0" Foreground="#BFD4EA" Click="Maximize_Click"/>
                    <Button Width="54" Height="32" Content="×" Background="Transparent" BorderThickness="0" Foreground="#BFD4EA" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main tabs -->
            <Grid Grid.Row="1" Margin="24,0,24,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabKeys" Style="{StaticResource TabButton}" Background="#0B6DEB" BorderBrush="#159BFF" Content="▦   Teclas" Click="TabKeys_Click"/>
                    <Button x:Name="TabActions" Style="{StaticResource TabButton}" Content="⌘   Ações" Margin="0,0,0,0" Click="TabActions_Click"/>
                    <Button x:Name="TabProfiles" Style="{StaticResource TabButton}" Content="◈   Perfis" Click="TabProfiles_Click"/>
                    <Button x:Name="TabDevice" Style="{StaticResource TabButton}" Content="▭   Dispositivo" Click="TabDevice_Click"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource FlatButton}" BorderBrush="#0788F7" Foreground="#29AEFF" FontSize="15" Content="⌨   Identificar Teclas" Click="TestMode_Click"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="2" Margin="24,0,24,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="575"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Left -->
                <ScrollViewer Grid.Column="0" Margin="0,0,14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SectionBorder}" MinHeight="335">
                        <StackPanel><TextBlock Text="Dispositivo Selecionado" FontSize="18" FontWeight="Bold"/>
                            <Border Background="#0D2233" BorderBrush="#23475F" BorderThickness="1" CornerRadius="9" Margin="0,14,0,10" Padding="15">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="⌨" FontSize="46" Foreground="#CFE4FC" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1"><TextBlock TextWrapping="Wrap" x:Name="DeviceNameText" Text="Nenhum dispositivo" FontWeight="SemiBold" FontSize="15"/><StackPanel Orientation="Horizontal" Margin="0,8,0,6"><Ellipse x:Name="DeviceStatusDot" Width="13" Height="13" Fill="#F8B33C"/><TextBlock x:Name="DeviceStatusText" Text="Aguardando seleção" Foreground="#EFC26C" FontSize="13" Margin="8,-1,0,0"/></StackPanel><TextBlock TextWrapping="Wrap" x:Name="DeviceDetailText" Text="VID: —&#10;PID: —&#10;Serial: —&#10;Produto: —&#10;Fabricante: —" Foreground="#A8C0D7" FontSize="12" LineHeight="19"/></StackPanel>
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource FlatButton}" Content="↻   Trocar Dispositivo" Height="50" Click="DeviceButton_Click"/>
                            <Button Style="{StaticResource FlatButton}" Content="✎   Renomear Dispositivo" Height="42" Margin="0,8,0,0" Click="RenameDevice_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionBorder}" MinHeight="175" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="Perfis" FontSize="18" FontWeight="Bold"/><Button Style="{StaticResource FlatButton}" Height="55" Margin="0,12,0,8" Click="ProfileMenu_Click"><Grid><Ellipse Width="16" Height="16" Fill="#0789FF" HorizontalAlignment="Left"/><TextBlock x:Name="LeftProfileName" Text="Padrão" FontSize="16" Margin="28,0,30,0"/><TextBlock Text="⌄" HorizontalAlignment="Right" FontSize="20"/></Grid></Button><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Button Style="{StaticResource FlatButton}" Content="Salvar" Padding="5,9" Click="Save_Click"/><Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="Salvar como" Padding="5,9" Margin="6,0,6,0" Click="DuplicateProfile_Click"/><Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="⋮" Padding="5,9" Click="ProfileMore_Click"/></Grid></StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionBorder}" Height="120" Margin="0,12,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Aplicar ao Iniciar" FontSize="18" FontWeight="Bold"/><CheckBox x:Name="StartupCheck" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="False" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/><TextBlock Grid.Row="1" Text="Iniciar o Switch Keypad com o Windows" Foreground="#9DB6D0" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- Keypad -->
                <Border Grid.Column="1" Style="{StaticResource SectionBorder}" Padding="36,24" Margin="0,0,14,0">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Grid x:Name="KeypadGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Height="620"/>
                    </Viewbox>
                </Border>

                <!-- Right configuration -->
                <Border Grid.Column="2" Style="{StaticResource SectionBorder}" Padding="18">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="3" Text="Configurar Tecla" FontSize="18" FontWeight="Bold" VerticalAlignment="Top"/>
                            <Border Grid.Column="0" Width="110" Height="110" Margin="0,34,0,0" Background="#0B1F2F" BorderBrush="#1E3C53" BorderThickness="2" CornerRadius="18"><TextBlock x:Name="SelectedKeyText" Text="0" FontSize="38" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="10,46,10,0"><TextBlock Text="Ação Atual" FontSize="14"/><Border Background="#0D2233" CornerRadius="8" Padding="12" Margin="0,8,0,0"><StackPanel><TextBlock TextTrimming="CharacterEllipsis" x:Name="CurrentActionTitle" Text="Abrir Aplicativos" FontWeight="SemiBold"/><TextBlock TextTrimming="CharacterEllipsis" x:Name="CurrentActionSubtitle" Text="Abre o Visual Studio Code" Foreground="#A9C0D8" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border></StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Limpar Tecla" Height="40" VerticalAlignment="Top" Margin="0,0,0,0" Click="ClearKey_Click"/><Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Alterar" Height="42" VerticalAlignment="Bottom" Margin="0,0,0,7" Click="ChangeAction_Click"/>
                        </Grid>
                        <UniformGrid Grid.Row="1" Rows="1" Columns="5">
                            <Button Style="{StaticResource FlatButton}" Padding="6,8" Content="Ações" Click="TabActions_Click"/>
                            <Button Style="{StaticResource FlatButton}" Padding="6,8" Content="Aplicativos" Tag="OpenApplication" Click="ActionType_Click"/>
                            <Button Style="{StaticResource FlatButton}" Padding="6,8" Content="Atalhos" Tag="SendHotkey" Click="ActionType_Click"/>
                            <Button Style="{StaticResource FlatButton}" Padding="6,8" Content="Sequência" Tag="MultiAction" Click="ActionType_Click"/>
                            <Button Style="{StaticResource FlatButton}" Padding="6,8" Content="Sistema" Tag="SystemAction" Click="ActionType_Click"/>
                        </UniformGrid>
                        <ScrollViewer x:Name="ActionScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8"><StackPanel>
                            <Button Style="{StaticResource ActionCard}" BorderBrush="#0A88FF" Click="ActionType_Click" Tag="OpenApplication"><StackPanel><TextBlock Text="◉   Abrir Aplicativo" FontWeight="SemiBold"/><TextBlock Text="Executa um programa ou atalho" Foreground="#9FB9D2" FontSize="12" Margin="30,3,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource ActionCard}" Click="ActionType_Click" Tag="SendHotkey"><StackPanel><TextBlock Text="⌨   Atalho de Teclado" FontWeight="SemiBold"/><TextBlock Text="Envia uma combinação de teclas (ex: Ctrl+S)" Foreground="#9FB9D2" FontSize="12" Margin="30,3,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource ActionCard}" Click="ActionType_Click" Tag="OpenFolder"><StackPanel><TextBlock Text="▭   Abrir Pasta" FontWeight="SemiBold"/><TextBlock Text="Abre uma pasta no Explorador de Arquivos" Foreground="#9FB9D2" FontSize="12" Margin="30,3,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource ActionCard}" Click="ActionType_Click" Tag="TypeText"><StackPanel><TextBlock Text="Tᵀ   Texto Personalizado" FontWeight="SemiBold"/><TextBlock Text="Digita um texto automaticamente" Foreground="#9FB9D2" FontSize="12" Margin="30,3,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource ActionCard}" Click="ActionType_Click" Tag="SystemAction"><StackPanel><TextBlock Text="⚙   Comando de Sistema" FontWeight="SemiBold"/><TextBlock Text="Volume, mídia, janelas, energia, etc." Foreground="#9FB9D2" FontSize="12" Margin="30,3,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource ActionCard}" Click="ActionType_Click" Tag="MultiAction"><StackPanel><TextBlock Text="◇   Sequência de Ações" FontWeight="SemiBold"/><TextBlock Text="Executa múltiplas ações em ordem" Foreground="#9FB9D2" FontSize="12" Margin="30,3,0,0"/></StackPanel></Button>
                        </StackPanel></ScrollViewer>
                        <Button Grid.Row="3" Style="{StaticResource PrimaryButton}" Height="56" FontSize="17" Content="✓   Salvar Alterações" Click="Save_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="30,0,30,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="FooterStatusDot" Width="16" Height="16" Fill="#F8B33C"/><TextBlock x:Name="FooterStatus" Text="Selecione um teclado numérico dedicado" Foreground="#BFD3E7" Margin="10,0,0,0" MaxWidth="1040" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button Grid.Column="1" Content="■  Parar sequências" Style="{StaticResource FlatButton}" Click="StopActions_Click" VerticalAlignment="Center" Margin="12,0,20,0"/>
                <TextBlock Grid.Column="2" Text="v0.4.1" Foreground="#8FA8C0" VerticalAlignment="Center"/>
            </Grid>
        </Grid></Viewbox>
    </Border>
</Window>
